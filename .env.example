# modu-valley — 외부 API 키 목록 (값은 비워 둔다)
#
# 사용법: 이 파일을 `.env.local` 로 복사해 값을 채운다. `.env*.local` 은 gitignore 되어 있다.
# 키는 서버(S1)·스크립트(scripts/)만 읽는다. 클라이언트 번들에 인라인되는 `EXPO_PUBLIC_*` 로는 절대 옮기지 않는다.
# 신청 절차·한도·약관: docs/API_KEYS.md

# ── VWorld (브이월드) 오픈API — WFS 표준유역·하천망(R2), 정사영상 WMS 오버레이(위성 토글), 지오코더
#    신청: vworld.kr 로그인 → 오픈API → 인증키 발급. 개발키 6개월, 도메인 등록제(서버 호출은 도메인 검사 없음).
#    한도: 지오코더 40,000/일, WMS·WFS 는 비공개. 영리 이용은 사전 서면 승인, 데이터 저장 금지(docs/API_KEYS.md §3·§4).
VWORLD_API_KEY=            # 개발키 (도메인: localhost 또는 DEFAULT)
VWORLD_API_KEY_2=          # 개발키 2 (도메인: 운영 도메인) — 하나만 쓰면 비워 둔다
VWORLD_API_KEY_PROD=       # 운영키 (심사 ~10일, 1년 갱신). 운영 배포 시

# ── 기상청 API허브 (apihub.kma.go.kr) — 방재기상관측(AWS) 매분 강우·지점정보(위경도·표고) → R1 커버리지, F3 강우 경보
#    신청: 회원가입(휴대전화 등록) 시 자동 발급, 마이페이지에서 확인. 한도: 일반 20,000건·5GB/일.
#    API 마다 활용신청이 따로 필요: 'AWS 매분자료 조회', '지점정보(stn_inf, inf=AWS)'.
KMA_APIHUB_KEY=

# ── 한강홍수통제소(HRFCO) 수문 Open API — 수위·강우 관측소 목록·10분 자료 → R1, F3 상류 경보
#    신청: hrfco.go.kr/web/openapiPage/certifyKey.do → 메일 [인증키 사용]. 사용 URL 이 다르면 키가 따로.
#    한도: 일일 한도 없음, 1분 1,000건 초과가 하루 3회면 차단. 1년 미사용 시 휴면.
HRFCO_API_KEY=             # 운영 도메인용
HRFCO_API_KEY_LOCAL=       # localhost 개발용 (URL 별 키가 다를 때만)

# ── 공공데이터포털 (data.go.kr) — 계정당 인증키 한 쌍을 승인된 모든 API 에 공용
#    승인 대상: 생활안전지도 물놀이관리지역(15101866, WMS) · 산사태위험지도(15149602) · 국토부 하천망(15058825)
#              · 표준권역(15056790) · 수자원관리도 WMS/WFS(15057885) · TAGO 버스도착(15098530)·시외(15098541)·고속(15098516)
#    한도: 개발계정 기본 1,000/일(TAGO 10,000), 운영계정 최대 100,000/일(활용사례 등록 후 심의 2~3일).
#    Encoding 키는 URL 에 그대로, Decoding 키는 라이브러리가 인코딩할 때 쓴다.
#    주의: 물놀이관리지역·하천망·표준권역·수자원관리도는 LINK 타입 — 이 키로 부르는 REST 가 아니라 원 기관 사이트로 연결된다. 이 키로 직접 부르는 것은 TAGO 만.
DATA_GO_KR_KEY_ENCODING=
DATA_GO_KR_KEY_DECODING=

# ── 생활안전지도 safemap.go.kr 자체 인증키 — data.go.kr 경로 대신 safemap XML/WMS(/openapi2/) 를 직접 쓸 때만
#    신청: safemap.go.kr/opna/crtfc/keyAgreeRenew.do (도메인 등록, 재전송 금지, 상업 이용 별도 허락)
SAFEMAP_API_KEY=

# 기상자료개방포털(data.kma.go.kr)은 별도 키가 없다 — 오픈API 는 data.go.kr 로 이관, AWS 분 자료는 API허브가 담당.

# ── 관리자 API 토큰 (OPS1, 제보 운영 도구) — `/api/admin/*` 인증. 생성: `openssl rand -base64 32`
#    비어 있으면 관리자 API 전체가 비활성(404). 웹 설정 → 제보 운영자 관리에서 인증한다. 네이티브 원본은 좌상단 10탭.
ADMIN_TOKEN=

# 실행 환경. web production은 같은 서버의 /api·/uploads 사용 (EXPO_PUBLIC_API_BASE 불필요).
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
# 운영 HTTPS origin을 정확히 입력. 개발 예: http://localhost:8084
ALLOWED_ORIGINS=
# 직접 서버 노출은 false. 신뢰하는 reverse proxy 뒤에서만 true.
TRUST_PROXY=false
JOBS_ENABLED=true
LOG_FORMAT=json
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=60
REPORTS_RATE_LIMIT_PER_10MIN=3
REPORTS_RATE_LIMIT_PER_DAY=20
ADMIN_RATE_LIMIT_PER_MIN=20
# 컨테이너는 /data 영속 볼륨을 사용. 로컬 실행은 필요한 경우 절대경로 지정.
# DB_PATH=/absolute/path/valley.db
# UPLOADS_DIR=/absolute/path/uploads
# WEB_DIR=/absolute/path/apps/valley-map/dist
# VWORLD_DOMAIN=app.example.com
