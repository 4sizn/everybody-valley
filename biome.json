{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.expo",
      "!**/dist",
      "!**/build",
      "!**/ios",
      "!**/android",
      "!docs/references",
      "!scripts/research",
      "!data/shade",
      "!data/facilities",
      "!data/valleys",
      "!data/seed",
      "!**/expo-env.d.ts",
      "!**/*.d.ts",
      "!design-system",
      "!packages/ui",
      "!apps/valley-map/src/journey/reference.css",
      "!apps/valley-map/public/assets/moduvalley",
      "!apps/valley-map/public/moduvalley"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    },
    "globals": ["__DEV__"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "useConst": "error",
        "useBlockStatements": "off",
        "noNonNullAssertion": "error",
        "useReadonlyClassProperties": "error",
        "noParameterProperties": "off",
        "useNamingConvention": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": []
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useLiteralKeys": "off"
      },
      "nursery": {
        "preset": "none"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/shared/logger/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/seed/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    }
  ]
}
