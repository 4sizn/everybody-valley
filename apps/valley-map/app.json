{
  "expo": {
    "name": "modu-valley",
    "slug": "valley-map",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "valleymap",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#18181c",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.valleymap",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "같은 Wi-Fi 의 개발 서버에서 계곡 화면을 받아옵니다.",
        "NSLocationWhenInUseUsageDescription": "지도를 현재 위치로 맞추고 가까운 계곡을 찾는 데 씁니다."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.valleymap"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "@maplibre/maplibre-react-native"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
